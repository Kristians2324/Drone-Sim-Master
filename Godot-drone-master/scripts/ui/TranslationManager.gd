func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_load_config()
	_register_all_translations()
	set_locale(current_locale)

func _load_config() -> void:
	var config = ConfigFile.new()
	if config.load(CONFIG_FILE_PATH) == OK:
		if config.has_section_key("localization", "language"):
			current_locale = config.get_value("localization", "language", "en")

func save_config() -> void:
	var config = ConfigFile.new()
	config.load(CONFIG_FILE_PATH)
	config.set_value("localization", "language", current_locale)
	config.save(CONFIG_FILE_PATH)

func _register_all_translations() -> void:
	if translations_loaded:
		return

	for loc_code in TRANSLATION_DATA.keys():
		var trans = Translation.new()
		trans.locale = loc_code

		var dict = TRANSLATION_DATA[loc_code]
		for key in dict.keys():
			trans.add_message(key, dict[key])

		TranslationServer.add_translation(trans)
		translation_objects[loc_code] = trans

	translations_loaded = true

# ============================================================================
# LOCALE API & RTL MANAGEMENT
# ============================================================================
func set_locale(loc_code: String) -> void:
	var valid_code = "en"
	for loc in SUPPORTED_LOCALES:
		if loc["code"] == loc_code:
			valid_code = loc_code
			break

	current_locale = valid_code
	TranslationServer.set_locale(current_locale)
	save_config()

	var active_rtl = is_rtl(current_locale)
	locale_changed.emit(current_locale, active_rtl)

func is_rtl(loc_code: String = "") -> bool:
	if loc_code == "":
		loc_code = current_locale

	for loc in SUPPORTED_LOCALES:
		if loc["code"] == loc_code:
			return loc["rtl"]
	return false

func get_supported_locales() -> Array:
	return SUPPORTED_LOCALES

func get_auto_translation(key: String, loc_code: String = "") -> String:
	if loc_code == "":
		loc_code = current_locale

	# Try exact key lookup in translation server
	var translated = tr(key)
	if translated != key:
		return translated

	# Fallback: Check internal dictionary
	if TRANSLATION_DATA.has(loc_code) and TRANSLATION_DATA[loc_code].has(key):
		return TRANSLATION_DATA[loc_code][key]

	# English fallback
	if TRANSLATION_DATA["en"].has(key):
		return TRANSLATION_DATA["en"][key]

	# Clean auto-formatting generator for unknown dynamic keys
	return key.capitalize().replace("_", " ")
